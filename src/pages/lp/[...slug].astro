---
import pages from '../../data/pages.json';
import { siteConfig } from '../../data/siteConfig';

import { variants } from '../../data/lpVariants';
export function getStaticPaths() {
  const variants = [
    {slug:'recurring-clogs',name:'Recurring clogs'},
    {slug:'sewer-backup',name:'Sewer backup'},
    {slug:'grease-and-roots',name:'Grease and roots'},
  ];
  return [{ params: { slug: undefined }, props: { variant: null } }, ...variants.map(variant => ({ params: { slug: variant.slug }, props: { variantSlug: variant.slug } }))];
}
const { variantSlug } = Astro.props;
const variant = variants.find(item => item.slug === variantSlug);
const home = pages['/'];
const extract = (pattern: RegExp) => {
  const match = home.match(pattern);
  if (!match) throw new Error('Topeka landing page cannot find shared site markup');
  return match[0].replace(/\{\{(GA4_ID|TRACKER_ID|BRAND|PHONE_DISPLAY|PHONE_HREF)\}\}/g, (_token, key) => ({
    GA4_ID: siteConfig.ga4MeasurementId,
    TRACKER_ID: siteConfig.airchattyTrackingId,
    BRAND: siteConfig.brand,
    PHONE_DISPLAY: siteConfig.phoneDisplay,
    PHONE_HREF: siteConfig.phoneHref,
  })[key]);
};
const header = extract(/<div class="utility">[\s\S]*?<\/header>/);
const footer = extract(/<footer class="footer">[\s\S]*?<\/footer>/);
const floatingCall = extract(/<a[^>]*class="fab-deal"[\s\S]*?<\/a>/);
const originalForm = extract(/<form class="form"[\s\S]*?<\/form>/);
const form = originalForm.replace('value="Homepage"', `value="Landing page: ${variant?.slug}"`);
const path = variant ? `/lp/${variant.slug}/` : '/lp/';
const title = variant ? `${variant.name} | Topeka Hydro Jetting Pros` : 'Topeka landing pages | Topeka Hydro Jetting Pros';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={variant ? variant.subheadline : 'Topeka Hydro Jetting Pros landing page variants.'} />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={`${siteConfig.origin}${path}`} />
  <link rel="stylesheet" href="/assets/site.css?nav=20260927-5" />
  <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.ga4MeasurementId}`}></script>
  <script is:inline define:vars={{ id: siteConfig.ga4MeasurementId }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',id);</script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Fragment set:html={header} />
  <main id="main">
  {variant ? (
    <>
      <section class="hero lp-hero">
        <div class="wrap lp-hero-grid">
          <div class="lp-hero-copy">
            <h1>{variant.headline}</h1>
            <div class="lp-subheadline">{variant.subheadline}</div>
          </div>
          <div class="lp-form-shell">
            <Fragment set:html={form} />
          </div>
        </div>
      </section>
      <section class="section"><div class="wrap lp-narrow">
        <h2>{variant.problemHeading}</h2>
        <p>{variant.problem}</p>
      </div></section>
      <section class="section alt"><div class="wrap lp-narrow">
        <h2>{variant.outcome}</h2>
        <p>{variant.outcomeCopy}</p>
        <p>{variant.detail}</p>
        <a class="btn" href="#main">Tell us about the drain</a>
      </div></section>
      <section class="section"><div class="wrap lp-narrow">
        <h2>What should you mention?</h2>
        <p>{variant.objection}</p>
        <p>Include the drains affected, when the issue began and any cleaning or inspection already done. The form above sends those details with your request.</p>
        <a class="btn" href="#main">Request a call</a>
        <p class="lp-call">Prefer to call? <a href={`tel:${siteConfig.phoneHref}`}>{siteConfig.phoneDisplay}</a></p>
      </div></section>
    </>
  ) : (
    <section class="section"><div class="wrap lp-index">
      <h1>Topeka landing pages</h1>
      <p>Citywide landing page variants for Topeka Hydro Jetting Pros.</p>
      <div class="grid">
        {variants.map(item => <article class="card"><h2>{item.name}</h2><p>{item.headline}</p><a href={`/lp/${item.slug}/`}>View landing page</a></article>)}
      </div>
    </div></section>
  )}
  </main>
  <Fragment set:html={footer} />
  <Fragment set:html={floatingCall} />
  <script is:inline data-tracking-id={siteConfig.airchattyTrackingId} defer src="https://api.airchatty.com/js/external-tracking.js"></script>
  <script is:inline defer src="/assets/site.js?nav=20260927-10"></script>
</body>
</html>
<style is:global>
.lp-hero .lp-hero-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(320px,.95fr);gap:54px;align-items:center;padding-top:76px;padding-bottom:76px}
.lp-hero h1{font-size:clamp(36px,4.5vw,61px);margin-bottom:23px}
.lp-subheadline{font-size:clamp(18px,2vw,22px);line-height:1.5;color:#d8eee8;max-width:600px}
.lp-form-shell{color:var(--ink);background:white;border-radius:12px;padding:26px;box-shadow:0 18px 42px #071d2290}
.lp-form-shell .form{box-shadow:none;padding:0}
.lp-form-shell .form textarea{min-height:82px}
.lp-form-shell .lead-success{color:var(--ink);border-radius:10px}.lp-form-shell .lead-success p{color:var(--muted);font-size:17px}.lp-form-shell .lead-success h2{font-size:clamp(23px,3vw,30px)}
.lp-narrow{max-width:780px}.lp-call{margin-top:24px!important}
.lp-index h1{font:800 clamp(36px,4vw,55px)/1.15 Manrope,sans-serif;letter-spacing:-.04em}
.lp-index .card h2{font:800 22px Manrope,sans-serif;margin:0 0 12px}
@media(max-width:900px){.lp-hero .lp-hero-grid{grid-template-columns:1fr;gap:30px;padding-top:60px;padding-bottom:60px}}
@media(max-width:640px){.lp-hero .lp-hero-grid{padding-top:46px;padding-bottom:46px}.lp-form-shell{padding:20px}.lp-hero h1{font-size:38px}.lp-subheadline{font-size:18px}.lp-form-shell .form input,.lp-form-shell .form textarea{font-size:16px}}
</style>
